ANTHROPIC_API_KEY=your_anthropic_api_key_here
DATABASE_URL=postgresql://postgres:postgres@localhost/mts_foods
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
# From Razorpay Dashboard > Settings > Webhooks (used to verify /payment/webhook calls)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
# Comma-separated allowed CORS origins — set to your EC2 IP or domain in production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost
